#!/usr/bin/env python3
"""Build, run, and sample-test standalone CSES solutions (Python stdlib only)."""
import argparse
import difflib
import json
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent


def sync_targets(problems):
    """Keep small Cargo entry points so editors can discover every solution."""
    directory = ROOT / "src/bin"
    directory.mkdir(parents=True, exist_ok=True)
    for problem in problems:
        slug = Path(problem["path"]).name
        runner = "interactive_runner.rs" if problem.get("interactive") else "runner.rs"
        source = (
            "// Generated by ./cses sync; edit the problem's solution.rs instead.\n"
            '#[path = "../macros.rs"]\nmod macros;\n\n'
            f'include!("../{runner}");\n'
            f'include!("../../{problem["path"]}/solution.rs");\n'
        )
        target = directory / f"{slug}.rs"
        if not target.exists() or target.read_text() != source:
            target.write_text(source)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("list")
    commands.add_parser("sync", help="create Cargo targets for indexed problems")
    for command in ("run", "test", "submit"):
        sub = commands.add_parser(command)
        sub.add_argument("problem", help="problem slug or CSES ID")
        if command == "run":
            sub.add_argument("--input", help="input file, or - for stdin")
        if command in ("run", "test"):
            sub.add_argument("--timeout", type=float, default=5, help="execution timeout in seconds (default: 5)")
    args = parser.parse_args()
    problems = json.loads((ROOT / "problems/index.json").read_text())
    if args.command == "sync":
        sync_targets(problems)
        print(f"Synced {len(problems)} Cargo targets")
        return 0
    if args.command == "list":
        for p in problems:
            print(f'{p["id"]:>4}  {Path(p["path"]).name}  ({p["category"]})')
        return 0
    matches = [p for p in problems if args.problem in (p["id"], Path(p["path"]).name, p["path"])]
    if len(matches) != 1:
        parser.error("unknown or ambiguous problem; use ./cses list")
    p = matches[0]
    if args.command == "test" and p.get("interactive"):
        parser.error("Interactive task: tests/example-transcript.txt is a conversation, not a test pair. A live interactor is required.")
    folder = ROOT / p["path"]
    slug = folder.name
    destination = ROOT / "target/submissions" / f"{slug}.rs"
    destination.parent.mkdir(parents=True, exist_ok=True)
    pieces = [f'// {p["name"]} — https://cses.fi/problemset/task/{p["id"]}/\n// Generated by ./cses; edit the source files instead.\n']
    runner = "interactive_runner.rs" if p.get("interactive") else "runner.rs"
    for source in (ROOT / "src/macros.rs", ROOT / "src" / runner, folder / "solution.rs"):
        pieces.append(f"// Source: {source.relative_to(ROOT)}\n" + source.read_text())
    destination.write_text("\n".join(pieces))
    binary = ROOT / "target/cses" / slug
    binary.parent.mkdir(parents=True, exist_ok=True)
    # Every command compiles exactly the standalone source destined for submission.
    subprocess.run(["rustc", "--edition=2021", "--crate-name", "cses_solution", "-O", str(destination), "-o", str(binary)], check=True)
    if args.command == "submit":
        print(destination)
        return 0
    if args.timeout <= 0:
        parser.error("--timeout must be positive")
    if args.command == "run":
        if args.input == "-":
            return subprocess.run([str(binary)], timeout=args.timeout).returncode
        source = Path(args.input) if args.input else folder / "input.txt"
        with source.open("rb") as stream:
            return subprocess.run([str(binary)], stdin=stream, timeout=args.timeout).returncode
    tests = sorted((folder / "tests").glob("*.in"))
    if not tests:
        raise ValueError("No tests found; add tests/<name>.in and tests/<name>.out")
    print("Comparing whitespace-separated tokens. Alternative valid outputs may differ from samples.")
    failures = 0
    for source in tests:
        expected_file = source.with_suffix(".out")
        if not expected_file.exists():
            print(f"FAIL {source.stem}: missing {expected_file.name}")
            failures += 1
            continue
        expected = expected_file.read_bytes()
        try:
            result = subprocess.run([str(binary)], input=source.read_bytes(), capture_output=True, timeout=args.timeout)
        except subprocess.TimeoutExpired:
            print(f"FAIL {source.stem}: timeout")
            failures += 1
            continue
        if result.returncode != 0:
            print(f"FAIL {source.stem}: exit {result.returncode}")
            print(result.stderr.decode(errors="replace"), end="")
            failures += 1
        elif result.stdout.split() != expected.split():
            print(f"FAIL {source.stem}: output mismatch")
            print("".join(difflib.unified_diff(expected.decode(errors="replace").splitlines(True), result.stdout.decode(errors="replace").splitlines(True), fromfile="expected", tofile="actual")))
            failures += 1
        else:
            print(f"PASS {source.stem}")
    print(f"{len(tests) - failures}/{len(tests)} passed")
    return int(failures > 0)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"error: {error}", file=sys.stderr)
        sys.exit(1)
